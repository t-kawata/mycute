.PHONY: run check build build-linux-amd64 setup-linux-amd64 up-mysql down-mysql conn-mysql clean-docker

# ============================================================
# lbug (LadybugDB) ビルドに必要な環境変数
# Apple Clang 15 は C++20 の aggregate initialization を完全サポートしていないため、
# macOS ネイティブビルドでは Homebrew の LLVM 21+ を使用する必要があります。
# 事前に `brew install llvm` を実行してください。
# ============================================================
LLVM_PATH := /opt/homebrew/opt/llvm

# ============================================================
# ターゲット: run (開発サーバー起動)
# ============================================================
run:
	CC=$(LLVM_PATH)/bin/clang \
	CXX=$(LLVM_PATH)/bin/clang++ \
	LDFLAGS="-L$(LLVM_PATH)/lib/c++ -Wl,-rpath,$(LLVM_PATH)/lib/c++" \
	cargo run -- ${ARGS}

# ============================================================
# ターゲット: check (コンパイルチェック)
# ============================================================
check:
	CC=$(LLVM_PATH)/bin/clang \
	CXX=$(LLVM_PATH)/bin/clang++ \
	LDFLAGS="-L$(LLVM_PATH)/lib/c++ -Wl,-rpath,$(LLVM_PATH)/lib/c++" \
	cargo check

# ============================================================
# ターゲット: build (macOS ネイティブリリースビルド)
# ============================================================
build:
	CC=$(LLVM_PATH)/bin/clang \
	CXX=$(LLVM_PATH)/bin/clang++ \
	LDFLAGS="-L$(LLVM_PATH)/lib/c++ -Wl,-rpath,$(LLVM_PATH)/lib/c++" \
	cargo build --release

# ============================================================
# ターゲット: build-linux-amd64 (Linux クロスコンパイル - Docker 使用)
# 
# Docker を使用して Linux AMD64 向けバイナリをビルドします。
# 前提条件: Docker Desktop が起動していること
# 
# 出力先: target/x86_64-unknown-linux-gnu/release/mycuters
# ============================================================
build-linux-amd64:
	@./scripts/build-linux.sh

# ============================================================
# ターゲット: clean-docker (Docker ビルドキャッシュのクリーンアップ)
# ============================================================
clean-docker:
	@echo "Docker ビルドイメージを削除中..."
	-docker rmi mycuters-linux-builder 2>/dev/null || true
	@echo "Cargo キャッシュボリュームを削除中..."
	-docker volume rm mycuters-cargo-cache 2>/dev/null || true
	@echo "完了。次回のビルドで再構築されます。"

# ============================================================
# ターゲット: up-mysql (MySQL コンテナ起動)
# ============================================================
up-mysql:
	cd ./docker && docker compose up -d

# ============================================================
# ターゲット: down-mysql (MySQL コンテナ停止)
# ============================================================
down-mysql:
	cd ./docker && docker compose down

# ============================================================
# ターゲット: conn-mysql (MySQL コンテナ接続)
# ============================================================
conn-mysql:
	mysql -h 127.0.0.1 -D mycuters -u asterisk -p

# ============================================================
# ターゲット: gen-migration (SeaORM マイグレーションファイル生成)
# ============================================================
gen-migration:
	@if [ -z "${NAME}" ]; then echo "\033[1;31mError: NAME is empty.\033[0m"; exit 1; fi
	mkdir -p ./src/migration && touch ./src/migration/mod.rs
	sea-orm-cli migrate generate ${NAME} -d ./src/migration

# ============================================================
# ターゲット: gen-entities (SeaORM エンティティファイル生成)
# ============================================================
gen-entities:
	@if [ -z "${HOST}" ]; then echo "\033[1;31mError: HOST is empty.\033[0m"; exit 1; fi
	mkdir -p ./src/entities && touch ./src/entities/mod.rs && touch ./src/entities/prelude.rs
	sea-orm-cli generate entity \
		--with-serde both \
		-u mysql://asterisk:yu51043chie3@${HOST}:3306/mycuters \
		-o ./src/entities
	@echo "Patching entity files for JST timestamp behavior..."
	@for file in ./src/entities/*.rs; do \
		basename=$$(basename "$$file"); \
		if [ "$$basename" != "mod.rs" ] && [ "$$basename" != "prelude.rs" ]; then \
			if ! grep -q "impl_utc_timestamp_behavior" "$$file"; then \
				sed -i '' 's/impl ActiveModelBehavior for ActiveModel {}/\/\/ impl ActiveModelBehavior for ActiveModel {}\ncrate::impl_utc_timestamp_behavior!(ActiveModel);/' "$$file"; \
				sed -i '' 's/DateTimeUtc/DateTime/g' "$$file"; \
				echo "  Patched: $$basename"; \
			else \
				echo "  Skipped (already patched): $$basename"; \
			fi \
		fi \
	done
	@echo "\033[1;32mEntity generation complete.\033[0m"